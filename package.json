{
    "name": "venthulir",
    "version": "1.0.0",
    "description": "Venthulir Organic E-Commerce — Frontend + Backend",
    "private": true,
    "scripts": {
        "install-backend":  "npm install --prefix backend  --legacy-peer-deps",
        "install-frontend": "npm install --prefix frontend --legacy-peer-deps",
        "install-all":      "npm run install-backend && npm run install-frontend",
        "backend":          "cd backend  && npm start",
        "frontend":         "cd frontend && npm run dev",
        "dev":              "concurrently \"npm run backend\" \"npm run frontend\"",
        "build":            "cd frontend && npm run build",
        "start":            "npm run backend"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
